mkdir working
cd /home/mzy/working
mkdir 20260721_Plasmodium

cd /data/database/GRCh38/
# 构建人类宿主参考基因组索引，用于bowtie2比对
conda run -n bowtie2_env bowtie2-build --threads 32 /data/database/GRCh38/GRCh38.p14.genome.fa /data/database/GRCh38/GRCh38
cd /home/mzy/working/20260721_Plasmodium
# 质控并过滤宿主序列
bash qc_and_host.sh 2>&1 | tee -a qc_and_host.log
mv 01.qc_and_host_result_* reports/
mv host_abundance_summary.tsv reports/
cd reports/
mkdir 01.qc_reports
mv *_fastp.* 01.qc_reports
cd ../

# 宏基因组比对物种鉴定
bash kraken2.sh 2>&1 | tee -a kraken2.log

# 评估物种相对丰度
zcat 01.qc_and_host_result/CX2628/CX2628_parasite_R1.fq.gz | head -n 4 | sed -n '2p' | awk '{print length($0)}' # 查看读长，修改脚本命令行
bash bracken.sh 2>&1 | tee -a bracken.log

# 汇总结果
conda run -n kraken2_env combine_bracken_outputs.py --files /home/user/working/03.bracken_result/*.bracken -o /home/user/working/03.bracken_result/combined_species_abundance.tsv
# 下载好数据库进行生成html
wget https://ftp.ncbi.nlm.nih.gov/pub/taxonomy/taxdump.tar.gz
conda run -n kraken2_env ktUpdateTaxonomy.sh
# 切换到 Bracken 结果目录，批量导入 kreport 文件生成单张网页
conda run -n kraken2_env ktImportTaxonomy -q 2 -t 3 /home/user/working/03.bracken_result/*_bracken.kreport -o /home/user/working/03.bracken_result/krona_abundance_summary.html
# 使用方法： 将生成的 krona_abundance_summary.html 文件下载到本地电脑，双击用
bash get_reads_assembly.sh 2>&1 | tee -a get_reads_assembly.log

# 分别对组装结果blast（这次原始数据reads太少，没能组装成全基因组）
blastn -query NY2621_contigs_500bp.fasta -db nt -remote -outfmt "6 qseqid sseqid pident length ... sscinames" -max_target_seqs 5 -out blast_results.tsv > blast.log 2>&1 &
